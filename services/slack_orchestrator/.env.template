# Coreline Slack Orchestrator — environment template
# Copy to .env and fill in. NEVER commit a real token; .env is gitignored.
# Secrets (SLACK_BOT_TOKEN) may instead be stored in the OS keychain under
# service "Coreline" (key: slack_bot_token) and left unset here.

# === Core ===
CORELINE_ENVIRONMENT=dev

# === Redis (Pub/Sub) ===
CORELINE_REDIS_URL=redis://localhost:6379/0
CORELINE_INCIDENT_CHANNEL_NAME=coreline:incident:created

# === Slack ===
# JSON array of Slack user IDs invited to each incident channel.
CORELINE_RESPONSE_TEAM_USER_IDS=["U01234567"]
# Slack bot token (xoxb-...). Prefer the OS keychain over this file.
SLACK_BOT_TOKEN=

# === Logging ===
CORELINE_LOG_LEVEL=INFO
