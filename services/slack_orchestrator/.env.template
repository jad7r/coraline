# ARES Slack Orchestrator — environment template
# Copy to .env and fill in. NEVER commit a real token; .env is gitignored.
# Secrets (SLACK_BOT_TOKEN) may instead be stored in the OS keychain under
# service "ARES" (key: slack_bot_token) and left unset here.

# === Core ===
ARES_ENVIRONMENT=dev

# === Redis (Pub/Sub) ===
ARES_REDIS_URL=redis://localhost:6379/0
ARES_INCIDENT_CHANNEL_NAME=ares:incident:created

# === Slack ===
# JSON array of Slack user IDs invited to each incident channel.
ARES_RESPONSE_TEAM_USER_IDS=["U01234567"]
# Slack bot token (xoxb-...). Prefer the OS keychain over this file.
SLACK_BOT_TOKEN=

# === Logging ===
ARES_LOG_LEVEL=INFO
